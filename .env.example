# =============================================================================
# OpenClaw Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# --- AI Provider API Keys (at least one required, unless using Ollama) ---

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (GPT) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter (multi-provider) - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini / Gemma - https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Mistral La Plateforme (direct API) - https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- Cloudflare Worker AI Gateway (Mistral + Gemma via Workers AI) ---
# Deploy the Worker in cf-worker/ then set these. See cf-worker/README.md.
# Include the trailing /v1 on the URL.
CF_WORKER_URL=https://openclaw-ai-gateway.your-subdomain.workers.dev/v1
# Must match the GATEWAY_TOKEN you set with: wrangler secret put GATEWAY_TOKEN
CF_WORKER_TOKEN=

# --- Gateway Configuration ---

# Docker Compose project name (required if repo folder name is not Compose-safe)
COMPOSE_PROJECT_NAME=openclaw

# Port for the OpenClaw Gateway API
OPENCLAW_GATEWAY_PORT=18789

# Port for the OpenClaw Bridge (channel connections)
OPENCLAW_BRIDGE_PORT=18790

# Network binding: "localhost" (default, secure) or "lan" (accessible on LAN)
OPENCLAW_GATEWAY_BIND=localhost

# --- Workspace ---

# Directory for OpenClaw workspace data
OPENCLAW_WORKSPACE_DIR=./workspace

# --- Optional Settings ---

# Enable sandbox mode (0 = disabled, 1 = enabled)
OPENCLAW_SANDBOX=0

# Log level: debug, info, warn, error
OPENCLAW_LOG_LEVEL=info

# Log format: text (human-readable) or json (structured)
OPENCLAW_LOG_FORMAT=text

# Metrics port for Prometheus scraping (used by monitoring overlay)
OPENCLAW_METRICS_PORT=9091
