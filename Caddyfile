# Caddyfile — alternative to nginx with automatic TLS via Let's Encrypt
#
# Usage:
#   1. Install Caddy: https://caddyserver.com/docs/install
#   2. Replace "your-domain.example.com" with your actual domain
#   3. Run: caddy run --config Caddyfile
#
# Caddy automatically obtains and renews TLS certificates.

your-domain.example.com {
	# Gateway API + WebSocket
	reverse_proxy localhost:18789

	# Bridge endpoint
	handle_path /bridge/* {
		reverse_proxy localhost:18790
	}

	# Health check (no logging)
	handle /healthz {
		reverse_proxy localhost:18789
		log {
			output discard
		}
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
